# ARX Collective — Environment Variables (Example)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=production

ADMIN_USERNAME=arx_admin
# Set ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD in production:
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-password>

SESSION_SECRET=<long-random-secret>

# Telegram Bot Token — obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Invite-only Username Whitelist
# Comma-separated list of usernames permitted to submit an application.
# Set to * to permit any person to apply.
AUTHORIZED_USERNAMES=*

# Custom Obscure Admin Route Path (Do NOT use /admin)
# Obscures administrative vectors behind a secret path.
ADMIN_SECRET_PATH=/arx-ops-console-7729

# Admin Static IP Whitelist
# Comma-separated list of static IP addresses permitted to access the admin portal.
# All other IPs receive HTTP 403 Forbidden. Set to * to disable IP restriction.
# IPs are automatically normalized: '::ffff:x.x.x.x' maps to bare IPv4 form.
# You do NOT need to add both '127.0.0.1' and '::ffff:127.0.0.1' — just use the bare IPv4.
ADMIN_ALLOWED_IPS=127.0.0.1,::1
